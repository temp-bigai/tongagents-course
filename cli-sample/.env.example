# LLM Configuration (OpenAI 兼容)
# cli-sample 用 OPENAI_* 三件套, 任意兼容端点都通
# (推荐) 用 Tong-Agent 内网 LLM 跑通测试:
#   cp ~/work/codework/tong_agents/Tong-Agent/.env .env
#   该 .env 已配 OPENAI_API_KEY + OPENAI_BASE_URL + OPENAI_MODEL

OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=http://your-llm-endpoint/v1
# OPENAI_MODEL=your-model-name
