# Lesson 1 环境变量模板
# 复制为 .env 后填入实际值（不要提交 .env 到 git）

# === TongAgents Nexus 镜像（pip 配置会读取，这里只是参考） ===
# PIP_INDEX_URL=https://nexus.mybigai.ac.cn/repository/pypi/simple/

# === LLM 配置（lesson3+ 需要用到，lesson1 仅占位） ===
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# === 模型服务端点（自部署 LLM 用，lesson3+ 用到） ===
# MODEL_NAME=gpt-4
# MODEL_URL=http://localhost:8000/v1
# MODEL_API_KEY=fake_api

# === 日志级别 ===
# LOG_LEVEL=INFO
